---
import OrnamentLayers from './OrnamentLayers.astro';
import { GIFT_ORNAMENTS, WEDDING_INFO } from '../data/invitation';
---

<div id="pagex_9">
  <div
    style={`overflow: hidden; text-align: center; padding: 180px 20px; margin: 0px; background-color: #11185e; background-image: url(${WEDDING_INFO.backgrounds.temple}); background-position: center; background-repeat: no-repeat; background-size: cover; position: relative; color: #E6C47A;`}
  >
    <OrnamentLayers layers={GIFT_ORNAMENTS} />

    <!-- Gift Content -->
    <div class="gift-widget">
      <div class="container-fluid" style="text-align: center;">
        <div class="row">
          <div>
            <div class="m_font4 sw108331" data-aos="zoom-out-up">Wedding Gift</div>
            <div class="m_font3 sw108332" data-aos="zoom-out-down">
              Kehadiran Anda merupakan sebuah doa serta rasa syukur bagi kami, namun apabila Bapak/Ibu/Saudara/i berkeinginan untuk memberikan tanda kasih, dapat menyampaikannya melalui tautan berikut:
            </div>
            <div data-aos="fade-down" style="margin-top: 10px;">
              <button type="button" class="button custome_button_gift" id="openModalGift">
                <i class="fa fa-gift"></i> Beri Kado
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PAGE 10: HIDDEN SPACER -->
<div id="pagex_10">
  <div
    style={`display: none; text-align: center; padding: 200px 20px 180px 20px; background-image: url(${WEDDING_INFO.backgrounds.temple}); background-position: center; background-repeat: no-repeat; background-size: cover; position: relative;`}
  ></div>
</div>
