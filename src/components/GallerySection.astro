---
import { GALLERY_PHOTOS } from '../data/invitation';
---

<div id="pagex_6">
  <div style="overflow: hidden; text-align: center; padding: 5px; position: relative; color: #333;">
    <ul id="responsive-images" class="list-unstyled row" style="margin-bottom: 0px; margin-top: 0px; padding: 2px 10px;">
      {GALLERY_PHOTOS.map((item) => (
        <li
          style="padding:2px;height:200px;cursor:pointer;"
          data-aos="zoom-in-up"
          class={item.colClass}
          data-src={item.src}
        >
          <img
            src={item.src}
            alt={item.alt}
            style="width:100%;height:100%;object-fit:cover;border-radius:0px;"
          />
        </li>
      ))}
    </ul>
  </div>
</div>
