---
interface Props {
  color?: string;
  className?: string;
  sizeStyle?: string;
}

const {
  color = '#E6C47A',
  className = '',
  sizeStyle = 'height: 180px; filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.45)); overflow: visible;',
} = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 240 220"
  role="img"
  aria-label="Logo Imam & Wulan"
  style={sizeStyle}
>
  <text
    x="92"
    y="132"
    text-anchor="middle"
    fill={color}
    font-size="108"
    font-family="'Embassy BT Local', 'Embassy BT', 'Great Vibes', cursive"
  >
    I
  </text>
  <text
    x="148"
    y="148"
    text-anchor="middle"
    fill={color}
    font-size="108"
    font-family="'Embassy BT Local', 'Embassy BT', 'Great Vibes', cursive"
  >
    W
  </text>
  <line
    x1="104"
    y1="176"
    x2="136"
    y2="176"
    stroke={color}
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.85"
  />
</svg>
