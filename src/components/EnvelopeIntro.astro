<!-- Envelope Opening Intro Overlay (GSAP + 3D Javanese Gunungan Envelope) -->
<section id="envelope-intro" aria-label="Amplop Undangan">
  <div class="envelope-stage">
    <div class="envelope-ambient-glow" aria-hidden="true"></div>

    <div class="envelope-unit" id="envelopeUnit" title="Ketuk untuk membuka amplop">
      <!-- Dynamic Ground Shadow -->
      <div class="envelope-ground-shadow" id="envelopeShadow" aria-hidden="true"></div>

      <!-- Layer 1: Cream Ivory Damask Interior Wall -->
      <div class="envelope-back">
        <svg class="envelope-back-svg" viewBox="0 0 600 390" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="ivoryBackGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#f7efe0" />
              <stop offset="40%" stop-color="#fbf6eb" />
              <stop offset="100%" stop-color="#ede0c7" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="600" height="390" fill="url(#ivoryBackGrad)" />
          <!-- Soft top fold crease shadow -->
          <rect x="0" y="0" width="600" height="10" fill="rgba(120, 75, 30, 0.14)" />
          <line x1="0" y1="1" x2="600" y2="1" stroke="rgba(155, 108, 52, 0.35)" stroke-width="1.5" />
        </svg>
      </div>

      <!-- Layer 2: Emerging Invitation Card Slot (Populated from #popup) -->
      <div class="envelope-pocket-mask" id="envelopePocketMask">
        <div class="envelope-card-clone" id="envelopeCardClone"></div>
      </div>

      <!-- Layer 3: Front Pocket with Megamendung Corner Relief & Gold Trim -->
      <div class="envelope-pocket-front">
        <svg viewBox="0 0 600 390" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="pocketGrad" x1="15%" y1="0%" x2="85%" y2="100%">
              <stop offset="0%" stop-color="#61310f" />
              <stop offset="45%" stop-color="#472108" />
              <stop offset="100%" stop-color="#2a1102" />
            </linearGradient>
            <radialGradient id="pocketSheen" cx="50%" cy="22%" r="68%">
              <stop offset="0%" stop-color="#9e5924" stop-opacity="0.28" />
              <stop offset="65%" stop-color="#4e2409" stop-opacity="0.06" />
              <stop offset="100%" stop-color="#1c0a01" stop-opacity="0.38" />
            </radialGradient>
            <linearGradient id="cloudRelief" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#9c5a24" stop-opacity="0.78" />
              <stop offset="50%" stop-color="#703912" stop-opacity="0.72" />
              <stop offset="100%" stop-color="#3c1905" stop-opacity="0.82" />
            </linearGradient>
            <linearGradient id="pocketGoldEdge" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#b57623" />
              <stop offset="25%" stop-color="#ffe7a6" />
              <stop offset="50%" stop-color="#e6b756" />
              <stop offset="75%" stop-color="#ffe7a6" />
              <stop offset="100%" stop-color="#b57623" />
            </linearGradient>
            <filter id="leatherGrain" x="0%" y="0%" width="100%" height="100%">
              <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="3" seed="7" result="noise" />
              <feColorMatrix type="matrix" values="0 0 0 0 0.9  0 0 0 0 0.7  0 0 0 0 0.45  0 0 0 0.06 0" in="noise" result="tintedNoise" />
              <feComposite in="tintedNoise" in2="SourceGraphic" operator="atop" />
            </filter>
            <g id="megamendungCorner">
              <!-- Deep shadow under cloud carving -->
              <path
                d="M -6,392 L -6,196 C 20,194 37,212 33,230 C 52,222 72,235 66,256 C 88,250 108,264 100,285 C 126,279 148,297 140,320 C 168,312 195,330 189,354 C 219,346 250,362 260,392 Z"
                fill="#1e0b02"
                opacity="0.5"
                transform="translate(2, 3)"
              />
              <!-- Outer tiered Megamendung cloud band -->
              <path
                d="M -8,392 L -8,198 C 18,196 35,214 31,232 C 50,224 70,236 64,256 C 86,250 106,264 98,284 C 124,278 146,296 138,318 C 166,310 192,328 186,352 C 216,344 248,360 258,392 Z"
                fill="url(#cloudRelief)"
                stroke="#220c02"
                stroke-width="1.8"
              />
              <!-- Mid tiered cloud relief -->
              <path
                d="M -8,392 L -8,244 C 15,242 29,255 25,271 C 43,265 60,277 54,293 C 76,287 96,301 90,319 C 116,313 136,331 130,349 C 158,341 186,359 196,392 Z"
                fill="#592c0c"
                fill-opacity="0.82"
                stroke="#9e5c26"
                stroke-width="1.3"
              />
              <!-- Inner cloud band -->
              <path
                d="M -8,392 L -8,296 C 12,295 25,307 21,322 C 38,317 55,328 49,344 C 70,338 90,352 84,368 C 108,362 128,376 134,392 Z"
                fill="#441f07"
                fill-opacity="0.88"
                stroke="#85491c"
                stroke-width="1.1"
              />
              <!-- Inner cloud spiral curls -->
              <path
                d="M 14,284 C 25,274 42,278 42,291 C 42,302 29,306 23,298 C 18,292 22,286 28,288"
                fill="none"
                stroke="#ad6a2f"
                stroke-width="2"
                stroke-linecap="round"
                opacity="0.8"
              />
              <path
                d="M 64,321 C 76,309 96,313 96,328 C 96,340 82,346 74,336 C 69,330 74,322 80,325"
                fill="none"
                stroke="#ad6a2f"
                stroke-width="2"
                stroke-linecap="round"
                opacity="0.8"
              />
              <path
                d="M 120,353 C 134,341 156,345 156,361 C 156,374 140,380 130,369 C 124,362 130,353 138,357"
                fill="none"
                stroke="#ad6a2f"
                stroke-width="2"
                stroke-linecap="round"
                opacity="0.8"
              />
              <!-- Side upper corner cloud accent -->
              <path
                d="M -6,150 C 24,150 45,167 41,186 C 62,184 80,198 74,217 C 94,217 108,231 100,250 C 78,246 60,236 44,225 C 22,213 6,195 -6,182 Z"
                fill="url(#cloudRelief)"
                stroke="#220c02"
                stroke-width="1.6"
                opacity="0.65"
              />
            </g>
          </defs>

          <!-- Three-Piece Brown Leather Front Pocket (Left Wing, Right Wing, Center Trapezoid) -->
          <!-- Left & Right Side Wings -->
          <path d="M 0,0 L 268,194 L 0,390 Z" fill="url(#pocketGrad)" />
          <path d="M 0,0 L 268,194 L 0,390 Z" fill="url(#pocketSheen)" filter="url(#leatherGrain)" />
          <path d="M 600,0 L 332,194 L 600,390 Z" fill="url(#pocketGrad)" />
          <path d="M 600,0 L 332,194 L 600,390 Z" fill="url(#pocketSheen)" filter="url(#leatherGrain)" />

          <!-- Subtle Gold Rim Along Left & Right V-Opening -->
          <path d="M 0,0 L 268,194" fill="none" stroke="url(#pocketGoldEdge)" stroke-width="2" opacity="0.65" />
          <path d="M 600,0 L 332,194" fill="none" stroke="url(#pocketGoldEdge)" stroke-width="2" opacity="0.65" />

          <!-- Upper Side Wing Megamendung Reliefs -->
          <use href="#megamendungCorner" />
          <use href="#megamendungCorner" transform="translate(600, 0) scale(-1, 1)" />

          <!-- Center Bottom Trapezoid Flap (Overlapping Left & Right Wings with Soft Shadow) -->
          <path
            d="M 0,390 L 236,184 Q 248,174 265,174 L 335,174 Q 352,174 364,184 L 600,390 Z"
            fill="#180801"
            opacity="0.48"
            transform="translate(0, -3)"
          />
          <path
            d="M 0,390 L 236,184 Q 248,174 265,174 L 335,174 Q 352,174 364,184 L 600,390 Z"
            fill="url(#pocketGrad)"
          />
          <path
            d="M 0,390 L 236,184 Q 248,174 265,174 L 335,174 Q 352,174 364,184 L 600,390 Z"
            fill="url(#pocketSheen)"
            filter="url(#leatherGrain)"
          />
          <path
            d="M 0,390 L 236,184 Q 248,174 265,174 L 335,174 Q 352,174 364,184 L 600,390"
            fill="none"
            stroke="rgba(165, 98, 38, 0.45)"
            stroke-width="1.6"
          />

          <!-- Bottom Corner Reliefs Clipped to Front Pocket -->
          <g opacity="0.82">
            <use href="#megamendungCorner" transform="translate(20, 48) scale(0.88)" />
            <use href="#megamendungCorner" transform="translate(580, 48) scale(-0.88, 0.88)" />
          </g>

          <!-- Outer Side & Bottom Leather Rim -->
          <path d="M 1.5,0 L 1.5,382 Q 1.5,388.5 9,388.5 L 591,388.5 Q 598.5,388.5 598.5,382 L 598.5,0" fill="none" stroke="rgba(230, 196, 122, 0.42)" stroke-width="2" />
        </svg>
      </div>

      <!-- Layer 4: 3D Hinged Top Flap + Ornate Gold Gunungan Seal -->
      <div class="envelope-flap" id="envelopeFlap">
        <div class="flap-face flap-front">
          <svg viewBox="0 0 600 390" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="flapGrad" x1="20%" y1="0%" x2="80%" y2="100%">
                <stop offset="0%" stop-color="#7c451b" />
                <stop offset="50%" stop-color="#5b2d0e" />
                <stop offset="100%" stop-color="#3c1905" />
              </linearGradient>
              <radialGradient id="flapSheen" cx="50%" cy="28%" r="65%">
                <stop offset="0%" stop-color="#b56c32" stop-opacity="0.28" />
                <stop offset="100%" stop-color="#220c02" stop-opacity="0.22" />
              </radialGradient>
              <linearGradient id="goldTrim" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#b37523" />
                <stop offset="25%" stop-color="#ffeaa8" />
                <stop offset="50%" stop-color="#e8b857" />
                <stop offset="75%" stop-color="#ffeaa8" />
                <stop offset="100%" stop-color="#b37523" />
              </linearGradient>
              <filter id="flapShadow" x="-10%" y="-10%" width="120%" height="135%">
                <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#120601" flood-opacity="0.65" />
              </filter>
            </defs>

            <!-- Curved Triangular Envelope Flap (Seamless hinge at y=0, 32px rounded shoulder) -->
            <g filter="url(#flapShadow)">
              <path
                d="M 0,0 L 600,0 L 600,32 C 594,88 465,168 300,248 C 135,168 6,88 0,32 Z"
                fill="url(#flapGrad)"
              />
              <path
                d="M 0,0 L 600,0 L 600,32 C 594,88 465,168 300,248 C 135,168 6,88 0,32 Z"
                fill="url(#flapSheen)"
                filter="url(#leatherGrain)"
              />
              <path
                d="M 2,32 C 8,88 135,168 300,248 C 465,168 592,88 598,32"
                fill="none"
                stroke="url(#goldTrim)"
                stroke-width="4.5"
                stroke-linecap="round"
              />
              <!-- Subtle top hinge crease highlight -->
              <line x1="0" y1="1" x2="600" y2="1" stroke="rgba(230, 196, 122, 0.35)" stroke-width="2" />
            </g>
          </svg>

          <!-- Ornate Golden Wayang Emblem Clasp (Pengait Amplop) -->
          <div class="gunungan-seal-slot">
            <div class="gunungan-seal" id="gununganSeal">
              <img
                src="/aseets/Ornate%20Golden%20Wayang%20Emblem.png"
                alt=""
                class="gunungan-seal-img"
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                aria-hidden="true"
              />
              <div class="seal-gleam-mask" aria-hidden="true">
                <div class="seal-gleam-bar"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Inner Ivory Damask Face of Flap (Visible when opened upward, upright Gunungan) -->
        <div class="flap-face flap-back">
          <svg viewBox="0 0 600 390" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="flapIvoryGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#f7efe0" />
                <stop offset="55%" stop-color="#fbf7ee" />
                <stop offset="100%" stop-color="#efe3cb" />
              </linearGradient>
              <g id="damaskScroll">
                <path d="M 35,34 C 58,28 74,44 66,62 C 60,74 44,72 42,60 C 40,51 50,46 56,52" fill="none" stroke="#dfd0b2" stroke-width="2.2" stroke-linecap="round" />
                <path d="M 88,68 C 114,58 134,76 124,96 C 117,110 99,108 96,95 C 94,85 104,79 112,86" fill="none" stroke="#dfd0b2" stroke-width="2.2" stroke-linecap="round" />
                <path d="M 150,104 C 176,94 196,112 186,132 C 179,146 161,144 158,131 C 156,121 166,115 174,122" fill="none" stroke="#dfd0b2" stroke-width="2" stroke-linecap="round" />
                <path d="M 212,142 C 234,134 250,150 242,166 C 236,178 220,176 218,165" fill="none" stroke="#dfd0b2" stroke-width="1.8" stroke-linecap="round" />
              </g>
            </defs>

            <!-- Outer Brown Leather Flap Edge (Matches exact 32px shoulder & continuous hinge) -->
            <path d="M 0,0 L 600,0 L 600,32 C 594,88 465,168 300,248 C 135,168 6,88 0,32 Z" fill="#592b0e" />

            <!-- Inner Ivory Damask Paper Triangle -->
            <path d="M 7,0 L 593,0 L 593,30 C 587,84 460,162 300,239 C 140,162 13,84 7,30 Z" fill="url(#flapIvoryGrad)" />

            <!-- Subtle Tone-on-Tone Damask Corner Scrolls -->
            <use href="#damaskScroll" opacity="0.7" />
            <use href="#damaskScroll" transform="translate(600, 0) scale(-1, 1)" opacity="0.7" />

            <!-- Metallic Gold Inner Border Along Open Flap -->
            <path
              d="M 7,0 L 7,30 C 13,84 140,162 300,239 C 460,162 587,84 593,30 L 593,0"
              fill="none"
              stroke="url(#goldTrim)"
              stroke-width="3.6"
              stroke-linecap="round"
            />

            <!-- Continuous Fold Crease Shadow at Hinge y=0 -->
            <line x1="0" y1="1" x2="600" y2="1" stroke="rgba(120, 75, 30, 0.25)" stroke-width="2" />
          </svg>

          <!-- Upright Ornate Golden Wayang Emblem Inside Open Flap -->
          <div class="flap-back-seal-slot" aria-hidden="true">
            <div class="flap-back-seal">
              <img
                src="/aseets/Ornate%20Golden%20Wayang%20Emblem.png"
                alt=""
                class="gunungan-seal-img"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="envelope-hint">Membuka Undangan...</div>
    </div>
  </div>
</section>
